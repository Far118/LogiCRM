# ── JWT ───────────────────────────────────────────────────────────────────────
# Генерация: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_VALUE
JWT_EXPIRES_IN=YOUR_VALUE

# ── CORS (в production — точный origin) ──────────────────────────────────────
CORS_ORIGIN=YOUR_VALUE

# ── Первый администратор (применяется при первом migrate) ─────────────────────
ADMIN_EMAIL=YOUR_VALUE
ADMIN_PASSWORD=YOUR_VALUE

# ── Сервер ────────────────────────────────────────────────────────────────────
NODE_ENV=YOUR_VALUE
PORT=YOUR_VALUE
# ── Dadata (поиск по ИНН) ────────────────────────────────────────────────────
# Бесплатный ключ: https://dadata.ru/profile/#info (10 000 запросов/день)
DADATA_API_KEY=YOUR_VALUE

#— сервер жестко запустит только 2 воркера, даже если ядер 8.
WEB_CONCURRENCY=YOUR_VALUE

WEB_CONCURRENCY=YOUR_VALUE