{
  "name": "logicrm-backend",
  "version": "1.0.0",
  "description": "LogiCRM REST API — Node.js + Express + PostgreSQL",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start":   "node server.js",
    "dev":     "node --watch server.js",
    "migrate": "node db/migrate.js",
    "seed":    "node db/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs":           "^2.4.3",
    "cookie-parser":     "^1.4.6",
    "cors":              "^2.8.5",
    "dotenv":            "^16.4.5",
    "express":           "^4.19.2",
    "express-rate-limit":"^7.3.1",
    "helmet":            "^7.1.0",
    "jsonwebtoken":      "^9.0.2",
    "knex":              "^3.1.0",
    "pg":                "^8.11.5",
    "uuid":              "^9.0.1",
    "web-push":          "^3.6.7",
    "zod":               "^4.4.3",
    "knex": "^3.1.0"
  }
}
